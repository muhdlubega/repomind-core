{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repomind-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "FRONTEND_URL": "https://repomind.example.com",
    "AI_PROVIDER": "cloudflare",
    "CLOUDFLARE_CHAT_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CLOUDFLARE_EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
    "ENABLE_EXTERNAL_AGENT": "false",
    "ENABLE_QUERY_REWRITE": "true",
    "QUERY_REWRITE_PROVIDER": "cloudflare",
    "ENABLE_AGENT_FALLBACK": "false",
    "AGENT_PROVIDER": "cloudflare",
    "AGENT_MODEL": "",
    "AGENT_MAX_ITERATIONS": "6",
    "LANGSMITH_TRACING": "false",
    "LANGSMITH_PROJECT": "repomind",
    "LANGSMITH_SAMPLE_RATE": "0",
    "ANONYMOUS_DAILY_QUERIES": "5",
    "AUTHENTICATED_DAILY_QUERIES": "20",
    "MAX_REPOSITORIES_PER_USER": "2",
    "MAX_REPO_FILES": "3000",
    "MAX_REPO_BYTES": "52428800",
    "MAX_FILE_BYTES": "524288",
    "MAX_INDEXABLE_CHUNKS": "20000",
    "MAX_GRAPH_DEPTH": "2"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "repomind", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "REPOSITORIES", "bucket_name": "repomind-repositories" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "REPLACE_WITH_KV_ID" }],
  "vectorize": [{ "binding": "CODE_INDEX", "index_name": "repomind-code" }],
  "ai": { "binding": "AI", "remote": true },
  "queues": {
    "producers": [{ "binding": "INDEX_QUEUE", "queue": "repomind-indexing" }],
    "consumers": [{ "queue": "repomind-indexing", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "repomind-indexing-dlq" }]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
