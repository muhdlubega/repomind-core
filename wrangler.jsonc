{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codelensa-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "FRONTEND_URL": "https://codelensa.pages.dev",
    "AI_PROVIDER": "mistral",
    "CLOUDFLARE_CHAT_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CLOUDFLARE_EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
    "ENABLE_EXTERNAL_AGENT": "true",
    "ENABLE_QUERY_REWRITE": "true",
    "QUERY_REWRITE_PROVIDER": "cloudflare",
    "ENABLE_AGENT_FALLBACK": "false",
    "AGENT_PROVIDER": "mistral",
    "AGENT_MODEL": "mistral-small-latest",
    "MISTRAL_MODEL": "mistral-small-latest",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "AGENT_MAX_ITERATIONS": "6",
    "LANGSMITH_TRACING": "true",
    "LANGSMITH_PROJECT": "codelensa",
    "LANGSMITH_SAMPLE_RATE": "0.05",
    "ANONYMOUS_DAILY_QUERIES": "5",
    "AUTHENTICATED_DAILY_QUERIES": "20",
    "MAX_REPOSITORIES_PER_USER": "2",
    "MAX_REPO_FILES": "3000",
    "MAX_REPO_BYTES": "52428800",
    "MAX_FILE_BYTES": "524288",
    "MAX_INDEXABLE_CHUNKS": "20000",
    "MAX_GRAPH_DEPTH": "2"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "codelensa", "database_id": "778de291-d1f4-44e8-a003-075c25dd82a4", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "REPOSITORIES", "bucket_name": "codelensa-repositories" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "c7c4ee0aae4847fab43690c8abbe6a01" }],
  "vectorize": [{ "binding": "CODE_INDEX", "index_name": "codelensa-code" }],
  "ai": { "binding": "AI", "remote": true },
  "queues": {
    "producers": [{ "binding": "INDEX_QUEUE", "queue": "codelensa-indexing" }],
    "consumers": [{ "queue": "codelensa-indexing", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "codelensa-indexing-dlq" }]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
