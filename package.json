{
  "name": "codelensa-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "cf-types": "wrangler types src/worker-configuration.d.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run build"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "hono": "^4.9.6",
    "langsmith": "^0.9.0",
    "openai": "^5.20.0",
    "web-tree-sitter": "^0.25.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.0"
  },
  "engines": { "node": ">=20" }
}
